# PostgreSQL
PG_HOST=postgres
PG_PORT=5432
PG_USER=chat
PG_PASSWORD=chat
PG_DATABASE=chat

# Redis
REDIS_URL=redis://redis:6379
REDIS_CHANNEL=chat:messages

# Auth
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=12h

# TLS (self-signed cert is generated at image build time)
TLS_ENABLED=false
TLS_CERT_PATH=/app/certs/server.crt
TLS_KEY_PATH=/app/certs/server.key

# Heartbeat
HEARTBEAT_INTERVAL_MS=30000
HEARTBEAT_TIMEOUT_MS=15000

# Rooms created automatically on first boot
DEFAULT_ROOMS=general,random

HISTORY_LIMIT=20
